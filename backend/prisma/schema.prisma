generator client {
 provider = "prisma-client-js"
}

datasource db {
 provider = "postgresql"
 url      = env("DATABASE_URL")
}

model User {
 id String @id @default(cuid())
 email String @unique
 name String?
 role String @default("TRAINEE")
 trainingRoute String @default("FULL_ACCESS")
 selectedModules String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 address String?
 paymentConfirmed Boolean @default(false)
 paymentConfirmedAt DateTime?
 phone String?
 postCode String?
 registrationDate DateTime @default(now())
 practicalModules String?
 loginCodes LoginCode[]
 moduleAttempts ModuleAttempt[]
 progress ModuleProgress[]
 results QuizResult[]
}

model Module {
 id Int @id
 name String
 passMark Int @default(15)
 questions String
 isPractical Boolean @default(false)
 moduleAttempts ModuleAttempt[]
 progress ModuleProgress[]
 results QuizResult[]
}

model ModuleAttempt {
 id String @id @default(cuid())
 userId String
 moduleId Int
 score Int
 passed Boolean
 answers String
 timeSpent Int
 completedAt DateTime
 attemptNumber Int @default(1)
 errors String?
 detailedAnswers String @default("[]")
 module Module @relation(fields: [moduleId], references: [id])
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ModuleProgress {
 id String @id @default(cuid())
 userId String
 moduleId Int
 status String @default("locked")
 score Int?
 attempts Int @default(0)
 passedAt DateTime?
 module Module @relation(fields: [moduleId], references: [id])
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 @@unique([userId, moduleId])
}

model QuizResult {
 id String @id @default(cuid())
 score Int
 passed Boolean @default(false)
 moduleId Int
 userId String
 createdAt DateTime @default(now())
 module Module @relation(fields: [moduleId], references: [id])
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginCode {
 id String @id @default(cuid())
 email String
 code String
 expiresAt DateTime
 used Boolean @default(false)
 createdAt DateTime @default(now())
 user User @relation(fields: [email], references: [email], onDelete: Cascade)
}

model PracticalAccessCode {
 id String @id @default(cuid())
 code String @unique
 isActive Boolean @default(true)
 generatedAt DateTime @default(now())
 expiresAt DateTime
 generatedBy String?
}

model DiscoveryForm {
  id               String   @id @default(cuid())
  learnerId        String   @unique
  firstName        String
  lastName         String
  phone            String
  email            String?
  addressTown      String?
  country          String?  @default("UK")
  courseAppliedFor String?
  firstCourse      Boolean  @default(false)
  sourceChannel    String?
  bookingMethod    String?
  reasonForChoice  String?
  priorExperience  String?
  experienceRating Int?
  futurePlans      String?
  comments         String?
  consentGiven     Boolean  @default(false)
  consentDate      DateTime?
  submittedVia     String?  @default("digital")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([learnerId])
  @@index([email])
  @@index([createdAt])
}

model RiskLog {
  id               String   @id @default(cuid())
  riskId           String   @unique
  dateRaised       DateTime @default(now())
  area             String
  description      String
  likelihood       String
  impact           String
  owner            String
  mitigation       String?
  status           String   @default("Open")
  dateClosed       DateTime?
  resolutionNotes  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([riskId])
  @@index([area])
  @@index([status])
  @@index([dateRaised])
}


model FAQEntry {
  id               String   @id @default(cuid())
  faqId            String   @unique
  question         String
  courseId         String?
  frequency        String   @default("Occasional")
  answer           String
  addedBy          String
  publishReady     Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([faqId])
  @@index([courseId])
}


model AttendanceRecord {
  id               String   @id @default(cuid())
  attendanceId     String   @unique
  learnerName      String
  learnerPhone     String
  courseName       String
  trainerName      String
  sessionDate      DateTime
  arrivalTime      String?
  departureTime    String?
  hoursAttended    Float?
  lateFlag         Boolean  @default(false)
  lateReason       String?
  noShowFlag       Boolean  @default(false)
  trainerNotes     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([attendanceId])
  @@index([sessionDate])
  @@index([learnerName])
  @@index([courseName])
}

model Course {
  id          String   @id @default(cuid())
  courseId    String   @unique
  title       String
  type        String   @default("Short Course")
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId])
  @@index([type])
}

 parts.push('<div class="section-title">📚 Detailed Module Results</div>');
 var attempts = reportData.attempts || [];
 if (attempts.length === 0) {
 parts.push('<div style="text-align: center; padding: 40px; color: #64748b;">📭 No module attempts recorded yet.</div>');
 } else {
 for (var a = 0; a < attempts.length; a++) {
 var attempt = attempts[a];
 var percentage = Math.round((attempt.score / 20) * 100);
 var isPassed = attempt.passed;
 var allQuestions = getAllQuestionsWithAnswers(attempt);
 parts.push('<div class="module-card">');
 parts.push('<div class="module-header">');
 var moduleName = attempt.module && attempt.module.name ? attempt.module.name : 'Unknown Module';
 parts.push('<span class="module-name">' + moduleName + '</span>');
 var statusText = isPassed ? 'PASSED' : 'FAILED';
 var statusClass = isPassed ? 'score-passed' : 'score-failed';
 parts.push('<span class="module-score ' + statusClass + '">' + attempt.score + '/20 (' + percentage + '%) - ' + statusText + '</span>');
 parts.push('</div>');
 parts.push('<div class="module-date">Completed: ' + new Date(attempt.completedAt).toLocaleString() + '</div>');
 if (allQuestions && allQuestions.length > 0) {
 parts.push('<table class="question-table">');
 parts.push('<thead><tr><th style="width: 6%;">#</th><th style="width: 44%;">Question</th><th style="width: 20%;">Student Answer</th><th style="width: 20%;">Correct Answer</th><th style="width: 10%;">Result</th></tr></thead>');
 parts.push('<tbody>');
 for (var q = 0; q < allQuestions.length; q++) {
 var question = allQuestions[q];
 var isCorrect = question.isCorrect !== undefined ? question.isCorrect : false;
 var rowClass = isCorrect ? 'correct' : 'incorrect';
 var answerClass = isCorrect ? 'answer-correct' : 'answer-incorrect';
 var resultSymbol = isCorrect ? '✅' : '❌';
 var questionText = question.questionText || 'N/A';
 var userAns = question.userAnswer || 'N/A';
 var correctAns = question.correctAnswer || 'N/A';
 parts.push('<tr class="' + rowClass + '">');
 parts.push('<td>' + (q + 1) + '</td>');
 parts.push('<td>' + questionText + '</td>');
 parts.push('<td class="' + answerClass + '">' + userAns + '</td>');
 parts.push('<td class="answer-correct">' + correctAns + '</td>');
 parts.push('<td>' + resultSymbol + '</td>');
 parts.push('</tr>');
 }
 parts.push('</tbody>');
 parts.push('</table>');
 } else {
 parts.push('<div class="no-errors">✅ Perfect! No incorrect answers in this module.</div>');
 }
 parts.push('</div>');
 }
 }
 parts.push('</div>');
 parts.push('<div class="footer">');
 parts.push('<p>This is an official training record generated by COHT Training Platform.</p>');
 parts.push('<p>© ' + new Date().getFullYear() + ' Centre of Healthcare Training - All Rights Reserved</p>');
 parts.push('<p style="margin-top: 4px; font-size: 10px;">trainercourses.com</p>');
 parts.push('</div>');
 parts.push('</div>');
 parts.push('<div class="no-print">');
 parts.push('<button class="print-btn" onclick="window.print()">🖨 Print / Save as PDF</button>');
 parts.push('<button class="close-btn" onclick="window.close()">❌ Close</button>');
 parts.push('</div>');
 parts.push('</body>');
 parts.push('</html>');
 html = parts.join("");
 printWindow.document.write(html);
 printWindow.document.close();
 };

